# Datasets and large files (root-level only, so ml/data/ source code is tracked)
/data/*
!/data/raw/
/data/raw/*
!/data/raw/plantvillage.dvc
!/data/raw/.gitignore
/archive/
archive*.zip
*.csv
*.xlsx
*.parquet

# ML models and checkpoints (root-level only)
/models/
/vision-models/*
!/vision-models/*.dvc
!/vision-models/.gitignore
*.h5
*.keras
*.pt
*.pth
*.onnx
*.pkl
*.joblib

# MLflow database and artifacts
mlflow.db
mlruns/
mlartifacts/

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# Node
node_modules/
.next/
dist/

# DVC cache
.dvc/cache/

# Environment variables
.env
.env.*
!.env.example
# Local test and release artifacts
.coverage
coverage.xml
htmlcov/
reports/local/
